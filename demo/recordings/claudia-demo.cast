[0.000, "o", "\u001b[H\u001b[K\r\n  still small? And whatever's actually on your mind right now, that's where we start.\u001b[K\r\n\u001b[K\u001b[38;5;246m\r\n✻\u001b[39m \u001b[38;5;246mSautéed for 15s\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[48;5;237m\r\n❯ \u001b[38;5;231mForty minutes!\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mWe argued for forty minutes!!!\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mabout a window.\u001b[39m\u001b[K\u001b[49m\r\n\u001b[K\u001b[38;5;231m\r\n⏺\u001b[39m Forty minutes. About a window.\u001b[K\r\n\u001b[K\r\n  So it didn't stay small. What was the window actually about?\u001b[K\r\n\u001b[K\u001b[38;5;246m\r\n✻\u001b[39m \u001b[38;5;246mChurned for 3s\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[48;5;237m\r\n❯ \u001b[38;5;231mI wanted him to notice I was cold\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mBEFORE I HAD TO ASK!!!\u001b[39m\u001b[K\u001b[49m\r\n\u001b[K\u001b[38;5;231m\r\n⏺\u001b[39m That's the telepathy problem walking right through the door — but this time with a draft coming   \u001b[20;1H  through it too.\u001b[K\r\n\u001b[K\r\n  So you were cold, he didn't clock it, and the tally started. Did you catch yourself doing it in   \u001b[23;1H  the moment, or only after — once you were forty minutes i"]
[0.000, "o", "nto arguing about the window itself?     \u001b[24;1H\u001b[K\u001b[38;5;174m\r\n✢\u001b[39m \u001b[38;5;216mP\u001b(B\u001b[m\u001b[38;5;174muzzling… \u001b(B\u001b[m\u001b[38;5;246m(5s · ↓\u001b[39m \u001b[38;5;246m229 tokens)\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;244m\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[38;5;246m\u001b[28;1H❯ \u001b[39m\u001b[K\u001b[38;5;244m\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[30;1H  \u001b[38;5;246m⏸ manual mode on · esc to interrupt · ← for agents\u001b[39m\u001b[44X\u001b[38;5;114m\u001b[44C/rc\u001b[39m \u001b[28;3H\u001b[?12l\u001b[?25h"]
[0.037, "o", "\u001b[?25l\u001b[38;5;231m\u001b[H⏺\u001b[39m Hi Agnès — how did it go trying the plain version with Jean-Pierre this week, while the thing was \u001b[2;1H  still small? And whatever's actually on your mind right now, that's where we start.\u001b[K\r\n\u001b[K\u001b[38;5;246m\r\n✻\u001b[39m \u001b[38;5;246mSautéed for 15s\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[48;5;237m\r\n❯ \u001b[38;5;231mForty minutes!\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mWe argued for forty minutes!!!\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mabout a window.\u001b[39m\u001b[K\u001b[49m\r\n\u001b[K\u001b[38;5;231m\r\n⏺\u001b[39m Forty minutes. About a window.\u001b[K\r\n\u001b[K\r\n  So it didn't stay small. What was the window actually about?\u001b[K\r\n\u001b[K\u001b[38;5;246m\r\n✻\u001b[39m \u001b[38;5;246mChurned for 3s\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;239m\u001b[48;5;237m\r\n❯ \u001b[38;5;231mI wanted him to notice I was cold\u001b[39m\u001b[K\u001b[49m\u001b[48;5;237m\r\n  \u001b[38;5;231mBEFORE I HAD TO ASK!!!\u001b[39m\u001b[K\u001b[49m\r\n\u001b[K\u001b[38;5;231m\r\n⏺\u001b[39m That's the telepathy problem walking right through the door — but this time with a draft coming   \u001b[20;1H  through it too.\u001b[K\r\n\u001b[K\r\n  So you were cold, he didn't clock it, "]
[0.000, "o", "and the tally started. Did you catch yourself doing it in   \u001b[23;1H  the moment, or only after — once you were forty minutes into arguing about the window itself?     \u001b[24;1H\u001b[K\u001b[38;5;174m\r\n✢\u001b[39m \u001b[38;5;216mP\u001b(B\u001b[m\u001b[38;5;174muzzling… \u001b(B\u001b[m\u001b[38;5;246m(6s · ↓\u001b[39m \u001b[38;5;246m229 tokens)\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;244m\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[38;5;246m\u001b[28;1H❯ \u001b[39m\u001b[K\u001b[38;5;244m\r\n────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[30;1H  \u001b[38;5;246m⏸ manual mode on · esc to"]
